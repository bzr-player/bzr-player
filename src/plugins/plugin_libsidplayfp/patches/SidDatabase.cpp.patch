+std::string SidDatabase::sidPath(const char *md5) {
+    if (m_parser == nullptr) {
+        errorString = ERR_NO_DATABASE_LOADED;
+        return "";
+    }
+
+    if (!m_parser->setSection("Database")) {
+        errorString = ERR_DATABASE_CORRUPT;
+        return "";
+    }
+
+    const char *value = m_parser->getValue(md5);
+
+    if (!value) {
+        errorString = ERR_DATABASE_CORRUPT;
+        return "";
+    }
+
+    const char *sidPath = std::strchr(value, '/');
+
+    if (!sidPath) {
+        return "";
+    }
+
+    return sidPath;
+}
